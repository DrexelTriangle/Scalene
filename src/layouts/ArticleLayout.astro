---
const { title, article } = Astro.props;
import Footer from "../components/Footer.astro";
import Splash from "../components/Splash.astro";
import { getSiteTitle } from "../utils/siteConfig";
import { normalizeText } from "../utils/data";
const siteTitle = await getSiteTitle();

const siteUrl = "https://www.thetriangle.org";
const cleanText = (value: unknown): string => normalizeText(String(value ?? ""));
const truncateDescription = (value: unknown): string => {
  const text = cleanText(value);
  if (text.length <= 160) return text;
  const clipped = text.slice(0, 157);
  const lastSpace = clipped.lastIndexOf(" ");
  return `${clipped.slice(0, lastSpace > 80 ? lastSpace : 157).trim()}...`;
};
const absoluteUrl = (value: unknown, fallback: string): string => {
  const url = String(value ?? "").trim();
  if (!url) return fallback;
  if (/^https?:\/\//i.test(url)) return url;
  if (url.startsWith("/")) return `${siteUrl}${url}`;
  return url;
};
const normalizeTagName = (tag: unknown): string => {
  if (typeof tag === "string") return cleanText(tag);
  if (tag && typeof tag === "object") {
    const record = tag as { name?: unknown; slug?: unknown };
    return cleanText(record.name ?? record.slug ?? "");
  }
  return "";
};
const normalizeTags = (raw: unknown): string[] => {
  let values: unknown[] = [];
  if (Array.isArray(raw)) {
    values = raw;
  } else if (typeof raw === "string") {
    const trimmed = raw.trim();
    if (trimmed.startsWith("[")) {
      try {
        const parsed = JSON.parse(trimmed);
        values = Array.isArray(parsed) ? parsed : [];
      } catch {
        values = trimmed.split(",");
      }
    } else {
      values = trimmed.split(",");
    }
  }
  const seen = new Set();
  return values
    .map(normalizeTagName)
    .filter((tag) => {
      if (!tag) return false;
      const key = tag.toLowerCase();
      if (seen.has(key)) return false;
      seen.add(key);
      return true;
    });
};

const fallbackTitle = cleanText(title || article?.title);
const seoTitle = cleanText(article?.seo?.seo_title) || fallbackTitle;
const resolvedTitle = seoTitle.replaceAll("The Triangle", siteTitle);
const description = (
  cleanText(article?.seo?.meta_description)
  || truncateDescription(article?.excerpt)
  || truncateDescription(article?.content)
);
const canonical = cleanText(article?.seo?.canonical_url) || `${siteUrl}/article/${article.slug}`;
const image = absoluteUrl(article?.featured_image, `${siteUrl}/logo.png`);
const publishedDate = article?.published_date || article?.date;
const modifiedDate = article?.modified_date || article?.updated_date || publishedDate;
const seoTags = normalizeTags(article?.seo?.tags ?? article?.tags ?? []);
const keywordTags = seoTags.length > 0
  ? seoTags
  : normalizeTags(article?.categories ?? article?.categories_list ?? []);

const websiteJSON = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteTitle,
  alternateName: ["Drexel Triangle", "The Drexel Triangle"],
  url: `${siteUrl}/`,
};

const newsArticleJSON = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonical,
  },
  headline: cleanText(article.title),
  image: [image],
  datePublished: publishedDate,
  dateModified: modifiedDate,
  description,
  keywords: keywordTags.join(", "),
  author: {
    "@type": "Organization",
    name: siteTitle,
  },
  publisher: {
    "@type": "Organization",
    name: siteTitle,
    logo: {
      "@type": "ImageObject",
      url: `${siteUrl}/logo.png`,
    },
  },
};

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=600, s-maxage=3600",
);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3937492883909624"
      crossorigin="anonymous"></script>

    <script type="text/javascript">
      (function (w, d, s, p) {
        const f = d.getElementsByTagName(s)[0],
          j = d.createElement(s);
        j.id = "flytedigital";
        j.async = true;
        j.src = "https://digital.flytedesk.com/js/head.js#" + p;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "prop_70U4oqbEQg0rQPaCMMuR");
    </script>

    <meta name="google-adsense-account" content="ca-pub-3937492883909624" />
    {description && <meta name="description" content={description} />}
    {keywordTags.length > 0 && <meta name="keywords" content={keywordTags.join(", ")} />}
    <meta name="robots" content="index, follow" />

    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={resolvedTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    {publishedDate && <meta property="article:published_time" content={publishedDate} />}
    {modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}
    {seoTags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@DrexelTriangle" />
    <meta name="twitter:title" content={resolvedTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={image} />

    <title>{resolvedTitle}</title>
    <Splash />
    <link rel="canonical" href={canonical} />

    <!-- Website JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteJSON)} />

    <!-- NewsArticle JSON-LD -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(newsArticleJSON)}
    />
  </head>

  <body class="w-100 min-h-screen flex flex-col">
    <!-- dark:bg-triangleDark dark:text-white -->
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      // Initialize Matomo.
      // `var` is required, not a style slip: matomo.js reassigns the global
      // _paq once it loads. `var` puts _paq on `window`, which that assignment
      // updates. A const/let binding here would shadow the window property and
      // make matomo.js throw "Assignment to constant variable".
      // eslint-disable-next-line no-var
      var _paq = (window._paq = window._paq || []);
      _paq.push(["trackPageView"]); // first page load
      _paq.push(["enableLinkTracking"]); // track clicks automatically

      (function () {
        const u = "https://stats.thetriangle.org/"; // your Matomo server
        _paq.push(["setTrackerUrl", u + "matomo.php"]);
        _paq.push(["setSiteId", "1"]); // keep same ID as WP or use new Site ID
        const d = document,
          g = d.createElement("script"),
          s = d.getElementsByTagName("script")[0];
        g.async = true;
        g.src = u + "matomo.js";
        s.parentNode.insertBefore(g, s);
      })();

      // Track Astro client-side navigation
      function trackPage() {
        if (window._paq) {
          _paq.push(["setCustomUrl", window.location.href]);
          _paq.push(["setDocumentTitle", document.title]);
          _paq.push(["trackPageView"]);
        }
      }

      // Track initial load
      document.addEventListener("DOMContentLoaded", trackPage);

      // Track SPA-like navigations
      document.addEventListener("astro:page-load", trackPage);
    </script>

    <noscript>
      <p>
        <img
          referrerpolicy="no-referrer-when-downgrade"
          src="//stats.thetriangle.org/matomo.php?idsite=1&rec=1"
          style="border:0;"
          alt=""
        />
      </p>
    </noscript>
  </body>
</html>
