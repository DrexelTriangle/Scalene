---
import Icon from "./Icon.astro";
---
<div class="font-playfair mb-[48px]">
    <h1 class="font-roboto-slab uppercase font-extrabold mb-2"> Follow Us </h1>
    <div class="text-[18px] mb-2 flex items-center gap-x-3 font-playfair">
        <Icon name="instagram" label="Instagram" class="text-triangleBlue text-[24px]"/> <a href="https://www.instagram.com/drexeltriangle/?hl=en" rel="noreferrer">@drexeltriangle</a>
    </div>
    <div class="text-[18px] mb-2 flex items-center gap-x-3 font-playfair">
        <Icon name="x-twitter" label="X" class="text-triangleBlue text-[24px]"/> <a href="https://x.com/DrexelTriangle" rel="noreferrer">@DrexelTriangle</a>
    </div>
    <div class="text-[18px] mb-2 flex items-center gap-x-3 font-playfair">
        <Icon name="letterboxd" label="Letterboxd" class="text-triangleBlue text-[24px]"/> <a href="https://letterboxd.com/drexeltriangle/" rel="noreferrer">@DrexelTriangle</a>
    </div>
    <div class="text-[18px] mb-2 flex items-center gap-x-3 font-playfair">
        <Icon name="reddit-alien" label="Reddit" class="text-triangleBlue text-[24px]"/> <a href="https://www.reddit.com/user/DrexelTriangle/" rel="noreferrer">u/DrexelTriangle</a>
    </div>
</div>
