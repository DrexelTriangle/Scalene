---
import PhotoArticle from "../PhotoArticle.astro";
import type { SectionCardArticle } from "../../utils/types";
import { slotSizes } from "../../utils/imageSizes";

interface Props {
  articles: SectionCardArticle[];
  /** Load the lead (centre) card's image eagerly; see PhotoArticle. */
  priority?: boolean;
}

const { articles, priority = false } = Astro.props;

// Always a full-width section. One column on phones; 3fr_6fr from md (the
// side column has no padding until lg); 3fr_6fr_3fr from lg.
const sideSizes = slotSizes("full", { md: { share: 3 / 9 }, lg: { share: 3 / 12, gutter: 12 } });
const leadSizes = slotSizes("full", { md: { share: 6 / 9, gutter: 24 }, lg: { share: 6 / 12, gutter: 24 } });

---
<div class="grid grid-cols-[1fr] md:grid-cols-[3fr_6fr] lg:grid-cols-[3fr_6fr_3fr] lg:divide-x lg:divide-triangleGray-400 ">
    <!-- Column 1: 2 blocks.
         These carry the breaking kicker as well as the centre card. More than
         one story can be breaking at a time now, and the second one is pinned
         to the slot right here: without this it would read as an ordinary
         story sitting next to a breaking one. -->
    <div class="flex flex-col space-y-2 lg:pr-[12px] order-2 md:order-none">
        {articles.slice(1, 3).map(article => (
            <PhotoArticle title={article.title} 
            image={article.featured_image}
            variants={article.featured_image_variants}
            author={article.authors}
            published_date={article.published_date}
            slug={"article/"+article.slug}
            breaking={article.breaking_news}
            sizes={sideSizes}/>
        ))}
    </div>

    <!-- Column 2: 1 block -->
    <div class="flex flex-col space-y-2 md:px-[12px] order-1 md:order-none">
        {articles.slice(0, 1).map(article => (
            <PhotoArticle title={article.title} 
            image={article.featured_image}
            variants={article.featured_image_variants}
            author={article.authors}
            published_date={article.published_date}
            excerpt={article.excerpt}
            slug={"article/"+article.slug}
            breaking={article.breaking_news}
            priority={priority}
            sizes={leadSizes}/>
        ))}
    </div>

    <!-- Column 3: 5 blocks -->
    <div class="flex flex-col lg:pl-[12px] order-3 md:order-none md:col-span-2 lg:col-span-1">
        {articles.slice(3, 9).map(article => (
            <PhotoArticle title={article.title} 
            category={article.categories}
            author={article.authors}
            published_date={article.published_date}
            slug={"article/"+article.slug}/>
        ))}
    </div>
</div>