---
import { normalizeText } from "../utils/data";
import type { Comment } from "../utils/types";

interface Props {
  comments: Comment[];
  slug: string;
  commentsClosed?: boolean;
}

const { comments = [], slug = "", commentsClosed = false } = Astro.props;

const sortedComments = [...comments].sort((a, b) => {
  const aDate = new Date(a.created_at_gmt || a.created_at || 0).getTime();
  const bDate = new Date(b.created_at_gmt || b.created_at || 0).getTime();
  if (aDate !== bDate) return aDate - bDate;
  return Number(a.id || 0) - Number(b.id || 0);
});

const commentsByID = new Map(sortedComments.map((comment) => [Number(comment.id), comment]));
const repliesByParent = new Map<number, Comment[]>();

for (const comment of sortedComments) {
  const parentID = Number(comment.parent_id || 0);
  if (!parentID || !commentsByID.has(parentID)) continue;

  const replies = repliesByParent.get(parentID) ?? [];
  replies.push(comment);
  repliesByParent.set(parentID, replies);
}

const topLevelComments = sortedComments.filter((comment) => {
  const parentID = Number(comment.parent_id || 0);
  return !parentID || !commentsByID.has(parentID);
});

const commentRows: Array<{ comment: Comment; depth: number; parentName: string }> = [];

function pushThread(comment: Comment, depth = 0, parentName = "") {
  commentRows.push({ comment, depth, parentName });
  const replies = repliesByParent.get(Number(comment.id)) ?? [];
  for (const reply of replies) {
    pushThread(reply, depth + 1, normalizeText(comment.author_name || "Anonymous"));
  }
}

for (const comment of topLevelComments) {
  pushThread(comment);
}

function depthStyle(depth: number) {
  if (depth <= 0) return undefined;
  return `margin-left: min(${Math.min(depth, 6) * 1.5}rem, 28vw);`;
}

function commentDate(comment: Comment) {
  const value = comment.created_at_gmt || comment.created_at;
  if (!value) return "";

  const d = new Date(value);
  if (Number.isNaN(d.getTime())) return "";

  const years = Math.floor((Date.now() - d.getTime()) / (365.25 * 24 * 60 * 60 * 1000));
  if (years > 0) return `${years} ${years === 1 ? "year" : "years"} ago`;

  return d.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}

function initials(name: string) {
  const cleaned = normalizeText(name || "Anonymous") || "Anonymous";
  return cleaned
    .split(/\s+/)
    .slice(0, 2)
    .map((part: string) => part[0])
    .join("")
    .toUpperCase();
}

function avatarTone(name: string) {
  const tones = [
    "bg-[#edf2f7] text-[#62717d]",
    "bg-[#eaf1ff] text-[#284da8]",
    "bg-[#eef7f1] text-[#2f6f49]",
    "bg-[#f6eeee] text-[#8b4b4b]",
  ];
  const source = normalizeText(name || "Anonymous") || "Anonymous";
  const sum = [...source].reduce((total, char) => total + char.charCodeAt(0), 0);
  return tones[sum % tones.length];
}
---

<section class="comments-section max-w-[760px] mx-auto mt-[48px] mb-[40px] print:hidden">
  <div class="border-t-[3px] border-triangleBlue pt-5 font-roboto-slab">
    <div class="flex flex-col gap-3 border-b border-triangleGray-400 pb-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2 class="text-[22px] font-extrabold text-neutral-900">
          {sortedComments.length} {sortedComments.length === 1 ? "Comment" : "Comments"}
        </h2>
        <p class="mt-1 text-[13px] font-semibold text-neutral-500">
          {commentsClosed ? "This discussion is closed." : "Join the discussion below."}
        </p>
      </div>
      <span class="text-[12px] font-extrabold uppercase tracking-[0.08em] text-triangleBlue">
        Reader discussion
      </span>
    </div>
  </div>

  {commentsClosed ? (
    <p class="mt-5 border-b border-triangleGray-400 pb-6 font-roboto-slab text-[15px] font-semibold text-neutral-600">Comments are closed.</p>
  ) : (
  <form data-comment-form class="mt-5 border-b border-triangleGray-400 pb-6 font-roboto-slab">
    <input type="hidden" name="slug" value={slug} />
    <input data-parent-input type="hidden" name="parent_id" value="0" />

    <div data-reply-context class="mb-3 hidden items-center justify-between rounded-[4px] bg-triangleGray-200 px-3 py-2 text-[13px] font-semibold text-neutral-600">
      <span data-reply-label></span>
      <button data-clear-reply type="button" class="font-extrabold text-triangleBlue hover:underline">Cancel reply</button>
    </div>

    <div class="grid gap-3 sm:grid-cols-2">
      <label class="block">
        <span class="mb-1 block text-[12px] font-extrabold uppercase tracking-[0.06em] text-neutral-500">Name</span>
        <input name="author_name" required maxlength="80" class="w-full border border-triangleGray-400 px-3 py-2 text-[15px] outline-none focus:border-triangleBlue" />
      </label>
      <label class="block">
        <span class="mb-1 block text-[12px] font-extrabold uppercase tracking-[0.06em] text-neutral-500">Email</span>
        <input name="author_email" type="email" maxlength="254" class="w-full border border-triangleGray-400 px-3 py-2 text-[15px] outline-none focus:border-triangleBlue" />
      </label>
    </div>

    <label class="mt-3 block">
      <span class="mb-1 block text-[12px] font-extrabold uppercase tracking-[0.06em] text-neutral-500">Comment</span>
      <textarea name="content" required maxlength="5000" rows="4" class="w-full resize-y border border-triangleGray-400 px-3 py-2 text-[15px] leading-[1.5] outline-none focus:border-triangleBlue"></textarea>
    </label>

    <div class="mt-3 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
      <p data-comment-status class="min-h-[20px] text-[13px] font-semibold text-neutral-500"></p>
      <button type="submit" class="self-start bg-triangleBlue px-4 py-2 text-[13px] font-extrabold uppercase tracking-[0.06em] text-white transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:bg-neutral-400">
        Post comment
      </button>
    </div>
  </form>
  )}

  {sortedComments.length > 0 ? (
      <ol class="mt-1">
        {commentRows.map(({ comment, depth, parentName }) => (
            <li
              class:list={[
                "grid gap-x-4 border-b border-triangleGray-400 font-roboto-slab",
                depth > 0
                  ? "grid-cols-[34px_1fr] py-4 pl-4 sm:grid-cols-[38px_1fr]"
                  : "grid-cols-[40px_1fr] py-5 sm:grid-cols-[44px_1fr]",
              ]}
              style={depthStyle(depth)}
            >
              <div class:list={[
                depth > 0
                  ? "mt-1 flex h-8 w-8 items-center justify-center rounded-full text-[11px] font-extrabold sm:h-9 sm:w-9"
                  : "mt-1 flex h-10 w-10 items-center justify-center rounded-full text-[12px] font-extrabold sm:h-11 sm:w-11",
                avatarTone(comment.author_name),
              ]}>
                {initials(comment.author_name)}
              </div>

              <article>
                <header>
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <span class="text-[15px] font-extrabold leading-tight text-neutral-950">
                      {normalizeText(comment.author_name || "Anonymous")}
                    </span>
                    {depth > 0 && parentName && (
                      <span class="text-[12px] font-semibold text-neutral-500">
                        replied to {parentName}
                      </span>
                    )}
                    {commentDate(comment) && (
                      <time datetime={comment.created_at_gmt || comment.created_at} class:list={[
                        "font-semibold text-neutral-500",
                        depth > 0 ? "text-[12px]" : "text-[13px]",
                      ]}>
                        {commentDate(comment)}
                      </time>
                    )}
                  </div>
                </header>

                <p class:list={[
                  "mt-2 whitespace-pre-line leading-[1.65] text-neutral-800",
                  depth > 0 ? "text-[15px]" : "text-[16px]",
                ]}>
                  {normalizeText(comment.content || "")}
                </p>
                {!commentsClosed && (
                  <button
                    type="button"
                    data-reply-to={comment.id}
                    data-reply-author={normalizeText(comment.author_name || "Anonymous")}
                    class="mt-3 text-[12px] font-extrabold uppercase tracking-[0.06em] text-neutral-500 hover:text-triangleBlue"
                  >
                    Reply
                  </button>
                )}
              </article>
            </li>
        ))}
      </ol>
  ) : (
    <p class="border-b border-triangleGray-400 py-6 font-roboto-slab text-[16px] text-neutral-600">No comments yet.</p>
  )}
</section>

<script>
  const form = document.querySelector("[data-comment-form]");
  const statusEl = document.querySelector("[data-comment-status]");
  const parentInput = document.querySelector("[data-parent-input]");
  const replyContext = document.querySelector("[data-reply-context]");
  const replyLabel = document.querySelector("[data-reply-label]");
  const clearReply = document.querySelector("[data-clear-reply]");

  function setStatus(message: string, isError = false) {
    if (!(statusEl instanceof HTMLElement)) return;
    statusEl.textContent = message;
    statusEl.classList.toggle("text-red-700", isError);
    statusEl.classList.toggle("text-neutral-500", !isError);
  }

  function clearReplyContext() {
    if (parentInput instanceof HTMLInputElement) parentInput.value = "0";
    if (replyContext instanceof HTMLElement) {
      replyContext.classList.add("hidden");
      replyContext.classList.remove("flex");
    }
  }

  document.querySelectorAll("[data-reply-to]").forEach((button) => {
    button.addEventListener("click", () => {
      if (!(button instanceof HTMLElement) || !(parentInput instanceof HTMLInputElement)) return;
      parentInput.value = button.dataset.replyTo || "0";
      if (replyLabel instanceof HTMLElement) {
        replyLabel.textContent = `Replying to ${button.dataset.replyAuthor || "comment"}`;
      }
      if (replyContext instanceof HTMLElement) {
        replyContext.classList.remove("hidden");
        replyContext.classList.add("flex");
      }
      form?.scrollIntoView({ behavior: "smooth", block: "center" });
    });
  });

  clearReply?.addEventListener("click", clearReplyContext);

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;

    const submit = form.querySelector("button[type='submit']");
    if (submit instanceof HTMLButtonElement) submit.disabled = true;
    setStatus("Posting...");

    try {
      const formData = new FormData(form);
      const response = await fetch("/api/comments", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(Object.fromEntries(formData.entries())),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        if (response.status === 403) {
          throw new Error("Comments are closed for this article or the comment service rejected this submission. (403)");
        }
        throw new Error(data.error ? `${data.error} (${response.status})` : `Could not post comment (${response.status})`);
      }
      if (data.status === "approved") {
        setStatus("Comment posted.");
        window.location.reload();
        return;
      }
      form.reset();
      clearReplyContext();
      setStatus("Comment submitted and awaiting moderation.");
    } catch (error) {
      const message = error instanceof Error ? error.message : "Could not post comment";
      setStatus(message, true);
    } finally {
      if (submit instanceof HTMLButtonElement) submit.disabled = false;
    }
  });
</script>
