---
import { activeAds, type AdPlacement } from "../utils/ads";

interface Props {
  placement: AdPlacement;
  class?: string;
}

// Not `slot`: Astro reserves that attribute for named slots, and a component
// carrying it at the top level of a layout is silently moved out of the page.
const { placement, class: className } = Astro.props;
const running = activeAds(placement);
---

{running.length > 0 && (
  <div class:list={["ad-slot", `ad-slot-${placement}`, className]}>
    {running.map((ad) => (
      <a href={ad.href} target="_blank" rel="sponsored noopener">
        <img class="ad" src={ad.image} alt={ad.alt} loading={placement === "homepage-banner" ? "eager" : "lazy"} decoding="async"/>
      </a>
    ))}
  </div>
)}
