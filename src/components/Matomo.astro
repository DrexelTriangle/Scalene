---
// Matomo analytics — the one tracker snippet, rendered by both BaseLayout and
// ArticleLayout. Counts exactly one page view per document: the initial load
// and each Astro ClientRouter navigation (which swaps in a new <body>).
//
// Several things can ask for a page view on the same page — this script on
// first parse, astro:page-load (which ClientRouter also fires on the initial
// window load), and a possible re-run of this script after a swap — so the
// view is keyed to the <body> element: whichever trigger comes first counts it,
// the rest see the marker and do nothing. ArticleLayout has no ClientRouter, so
// there only the first trigger ever fires.
//
// tests/matomo.test.ts runs this script against a fake DOM and counts views.
---

<script is:inline>
  // `var` is required, not a style slip: matomo.js reassigns the global _paq
  // once it loads. `var` puts _paq on `window`, which that assignment updates.
  // A const/let binding here would shadow the window property and make
  // matomo.js throw "Assignment to constant variable", killing analytics.
  // eslint-disable-next-line no-var
  var _paq = window._paq = window._paq || [];

  (function() {
    function trackPageView() {
      const body = document.body;
      if (!body || body.hasAttribute('data-matomo-tracked')) return;
      body.setAttribute('data-matomo-tracked', '');
      window._paq.push(['setCustomUrl', window.location.href]);
      window._paq.push(['setDocumentTitle', document.title]);
      window._paq.push(['trackPageView']);
    }

    if (!window.__triangleMatomo) {
      window.__triangleMatomo = true;
      const u = "https://stats.thetriangle.org/";
      _paq.push(['enableLinkTracking']);
      _paq.push(['setTrackerUrl', u + 'matomo.php']);
      _paq.push(['setSiteId', '1']);
      const d = document, g = d.createElement('script'), s = d.getElementsByTagName('script')[0];
      g.async = true; g.src = u + 'matomo.js';
      s.parentNode.insertBefore(g, s);
      document.addEventListener('astro:page-load', trackPageView);
    }

    trackPageView();
  })();
</script>

<noscript>
  <p>
    <img
      referrerpolicy="no-referrer-when-downgrade"
      src="//stats.thetriangle.org/matomo.php?idsite=1&rec=1"
      style="border:0;"
      alt=""
    />
  </p>
</noscript>
