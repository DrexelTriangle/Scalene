---
import "@splidejs/splide/dist/css/splide.min.css";
import type { HomepageCarouselSlide } from "../utils/types";

// The nav (#scrollnav) carries mb-[24px], and whichever block comes first after
// it pulls itself up by 24px to sit flush. That is normally this hero -- but when
// the breaking-news banner renders, IT is first and does the pulling, so this
// must not pull up too or it overlaps the banner and hides its lower half.
const { pullUp = true, slides = [] } = Astro.props as {
  pullUp?: boolean;
  slides?: HomepageCarouselSlide[];
};

const defaultSlides: HomepageCarouselSlide[] = [
  {
    enabled: true,
    title: "100 Years of The Triangle",
    link_url: "/one-hundred",
    image_url: "",
    background_color: "",
    text_color: "#ffffff",
    desktop_only: true,
  },
  {
    enabled: true,
    title: "Podcast",
    link_url: "https://tr.ee/bqz8s-E4NK",
    image_url: "/images/PodcastBanner.webp",
    background_color: "#acd4f4",
    text_color: "#ffffff",
    desktop_only: false,
  },
  {
    enabled: true,
    title: "Classifieds",
    link_url: "/classifieds",
    image_url: "/images/classifiedsBannerNew.webp",
    background_color: "#E5E7EB",
    text_color: "#ffffff",
    desktop_only: false,
  },
  {
    enabled: true,
    title: "Apply to The Triangle",
    link_url: "https://docs.google.com/forms/d/e/1FAIpQLScra_6sUenvmpIuQ5FjmMyWO0a2sz9z36HkrqfnYQvJGH9BGQ/viewform",
    image_url: "/images/applyBannerNew.webp",
    background_color: "#275997",
    text_color: "#ffffff",
    desktop_only: false,
  },
];

const carouselSlides = (slides.length > 0 ? slides : defaultSlides).filter((slide) => slide.enabled);
---

<section class:list={["home-hero-wrap relative mb-[16px] md:mb-[0px]", pullUp && "mt-[-24px]"]}>
  {
    carouselSlides.some((slide) => !slide.image_url) && (
      <div class="one-hundred-bg hidden md:block" aria-hidden="true"></div>
    )
  }

  <div class="splide relative z-[2]" aria-label="My Splide" data-home-splide>
    <div class="splide__track">
      <ul class="splide__list">
        {
          carouselSlides.map((slide) => (
            <li class:list={[slide.desktop_only && "hidden md:block", "splide__slide w-[100%] mb-[12px] md:mb-[0px]"]}>
              <a
                href={slide.link_url}
                style={`background-color: ${slide.background_color || "transparent"}; color: ${slide.text_color || "#ffffff"};`}
                class:list={[
                  slide.image_url
                    ? "block"
                    : "one-hundred-slide md:aspect-[4] lg:aspect-[7.5] flex px-[16px] justify-end items-end text-wrap font-bold uppercase font-libre text-[32px] sm:text-[48px] lg:text-[48px] leading-[normal] relative",
                ]}
              >
                {slide.image_url ? (
                  <img
                    src={slide.image_url}
                    alt={slide.title}
                    class="w-full md:object-contain object-cover md:aspect-[4] lg:aspect-[7.5]"
                  />
                ) : (
                  <span class="z-[10] text-right">{slide.title}</span>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  import Splide from "@splidejs/splide";

  function initSplides() {
    document.querySelectorAll<HTMLElement>("[data-home-splide]").forEach((el) => {
      if (el.dataset.splideMounted === "true") return;

      el.dataset.splideMounted = "true";

      new Splide(el, {
        type: "loop",
        perPage: 1,
        autoplay: true,
        arrows: false,
        pagination: false,
        keyboard: false,
        drag: false,
        speed: 1200,
      }).mount();
    });
  }

  initSplides();

  document.addEventListener("astro:page-load", initSplides);
</script>
