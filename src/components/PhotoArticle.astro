---
import { normalizeText, buildByline, proxyMediaUrl } from '../utils/data';
import { getCategoryHref } from '../utils/taxonomyStore';
import { isComicPost } from '../utils/comics';

// `category` decides whether this card shows a kicker -- each layout passes it
// only where it wants one -- so it cannot double as the card's taxonomy.
// `categories` is the article's own list, passed everywhere, for the crop.
const { title, excerpt, image, author, published_date, date, category, categories, row, slug, breaking } = Astro.props;

const DEFAULT_IMGS = [
  '/proxy/wp-content/uploads/2024/12/IMG_2493-2048x1365.jpg',
  '/proxy/wp-content/uploads/2026/02/what-gets-drexel-students-through-sarah-ruzicka.jpg',
  '/proxy//wp-content/uploads/2023/12/Drexel-Summary-and-Analysis-of-Report-Lucas-Tusinean-2-scaled.jpeg'
];

let imgSrc = image || DEFAULT_IMGS[Math.floor(Math.random() * DEFAULT_IMGS.length)];
if (image !== undefined) {
  imgSrc = proxyMediaUrl(imgSrc);
}

const byline = buildByline(author, published_date || date);

// Most WordPress categories are not pages of their own, so the label only gets
// an href where the taxonomy says it leads somewhere. See getCategoryHref.
const categoryHref = category ? await getCategoryHref(category[0]) : null;

const classes = row
  ? 'mb-[4px] md:mb-[0px] flex-1 sm:px-[16px] first:pl-0 sm:last:pr-0'
  : 'mb-[4px] md:mb-[0px] [.grid_&:not(:first-child)]:pt-[8px] pb-[8px] cursor-default [&:not(:last-child)]:border-b-[1px] border-solid border-triangleGray-400';

// A photo fills its 4:3 box and loses whatever falls outside it. A comic can't
// afford that -- see comics.ts -- so it is fitted whole inside the same box
// instead, keeping the card's height and the row's alignment.
const fit = isComicPost(categories ?? category) ? 'object-contain' : 'object-cover';

const imgClass = row
  ? `aspect-[4/3] w-[100%] sm:h-[200px] ${fit}`
  : `aspect-[4/3] ${fit} w-[100%]`;
---

<article class={classes}>
  {image !== undefined && (
    <a href={`/${slug}`}>
      <img class={imgClass} loading="lazy" src={imgSrc} alt={title || 'Article image'} />
    </a>
  )}
  {category && (
    <a href={categoryHref ?? undefined}>
      <h3 class="font-roboto-slab uppercase font-extrabold text-triangleBlue text-[10px] font-700">
        {normalizeText(category[0].name)}
      </h3>
    </a>
  )}
  {breaking && <h3 class="font-roboto-slab uppercase font-extrabold text-triangleDanger text-[12px] py-1 font-700 italic">Breaking News</h3>}
  <a href={`/${slug}`}>
    <h2 class="font-playfair text-[20px] leading-tight hover:underline">{normalizeText(title)}</h2>
  </a>
  <div id="byline" class="font-playfair text-[12px]" set:html={byline} />
  {excerpt && <div set:html={normalizeText(excerpt)} class="text-[16px]" />}
</article>
