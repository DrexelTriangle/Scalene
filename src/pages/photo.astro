---

// export const prerender = false;
import Header from '../components/Header.astro';
import BaseLayout from "../layouts/BaseLayout.astro";
import '../styles/global.css';

import { gallery } from '../utils/db';
import { imageSrcset } from '../utils/data';

const images = (await gallery()) ?? [];

// One tile of the masonry grid below: a quarter of the 1200px/900px container
// at md and up, a third at sm, half below that (of the 90vw container).
const tileSizes =
  "(min-width: 1280px) 300px, (min-width: 1024px) 225px, (min-width: 768px) 23vw, (min-width: 640px) 30vw, 45vw";
---
<BaseLayout title="Photo Gallery - The Triangle">
  <Header />
  <section>
    <h1 class="my-2 xl:max-w-[1200px] lg:max-w-[900px] max-w-[90%] mx-[auto] font-playfair text-[36px]">Photo Gallery </h1>
    <div class="mx-auto xl:max-w-[1200px] lg:max-w-[900px] max-w-[90%] mx-[auto] columns-2 sm:columns-3 md:columns-4 gap-4">
      {/* gallery() now reads the CMS (/v1/gallery), which serves canonical
          media URLs — no legacy-origin rewrite needed. */}
      {images.map((img) => (
        <img
          src={img.url}
          srcset={imageSrcset(img.variants)}
          sizes={img.variants?.length ? tileSizes : undefined}
          alt={img.alt_text ?? ""}
          class="mb-4 w-full rounded-lg break-inside-avoid"
          loading="lazy"
        />
      ))}
    </div>
  </section>
</BaseLayout>




