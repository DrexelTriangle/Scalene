---
    export const prerender = true;
    import BaseLayout from "../layouts/BaseLayout.astro";
    import Header from '../components/Header.astro';
    import { STAFF, portraitAttrs } from "../utils/staff";
    import '../styles/global.css';
---
<BaseLayout title="Staff - The Triangle">
    <Header/>
<section class="xl:max-w-[1200px] lg:max-w-[900px] max-w-[90%] mx-[auto]">
    <h1 class="font-playfair text-[42px] mb-[16px]"> Our Staff </h1>
    <div class="staff-row grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 mb-5">
        {STAFF.map((member, index) => (
            <div class="staff-card">
                <img {...portraitAttrs(member, index)} />
                <h3 style="margin-bottom: 0px;">{member.name}</h3>
                <hr style="width:50%;margin: 0 auto;"/>
                <b>{member.role}</b>
                {member.emails.map((email) => {
                    const at = email.indexOf("@");
                    return <a href={`mailto:${email}`}>{email.slice(0, at)}<wbr>{email.slice(at)}</a>;
                })}
            </div>
        ))}
    </div>
</section>
</BaseLayout>
