---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import Section from '../components/Sections/Section.astro';
import Header from '../components/Header.astro';
import Column from '../components/Columns.astro';
import Social from '../components/Social.astro';
import BreakingNewsBanner from '../components/BreakingNewsBanner.astro'
import Developing from '../components/Developing.astro'
import '../styles/global.css';
import { getHomepageArticles } from '../utils/db';
import SubscribeLink from "../components/SubscribeLink.astro";
import Banner from "../components/Banner.astro";
import HeroBackgroundPreload from "../components/HeroBackgroundPreload.astro";
// What changes here without a CMS write is a server island, fetched after the
// page: ads and the exhibit spotlight turn over by date, the poll by vote. The
// page itself is cached for a day and purged by tag on every write (below).
// These import names are the islands' URLs -- never rename them.
import HomeBannerAdIsland from "../components/islands/HomeBannerAdIsland.astro";
import { activeAds } from "../utils/ads";
import SidebarAdIsland from "../components/islands/SidebarAdIsland.astro";
import PollIsland from "../components/islands/PollIsland.astro";
import ExhibitSpotlightIsland from "../components/islands/ExhibitSpotlightIsland.astro";

const posts = await getHomepageArticles();

// `items` carries every story on the banner. A CMS that predates it sends only
// `text`/`article_slug`, so fall back to that pair rather than showing nothing:
// the two repos deploy independently, and an empty banner during the gap is
// exactly the failure worth avoiding.
const breakingNews = posts.breaking_news;
const breakingItems = (breakingNews?.items ?? [])
  .map((item) => ({ text: item.text?.trim() ?? "", article_slug: item.article_slug?.trim() }))
  .filter((item) => item.text !== "");
if (breakingItems.length === 0 && (breakingNews?.text?.trim() ?? "") !== "") {
  breakingItems.push({
    text: breakingNews!.text.trim(),
    article_slug: breakingNews?.article_slug?.trim(),
  });
}
const breaking = (breakingNews?.enabled ?? false) && breakingItems.length > 0;

// The banner ad is an island (it turns over by date), so it lands after the
// page. When a banner with known dimensions is running as this page renders,
// its space is held for it. A campaign that starts while this copy sits in the
// cache gets no reservation and shifts the page once, until the next purge.
const bannerClass =
  "xl:max-w-[1200px] lg:max-w-[900px] max-w-[90%] mx-[auto] mt-[12px] mb-[8px] [&_img]:block [&_img]:mb-0 [&_img]:border [&_img]:border-solid [&_img]:border-[#d9d9d9]";
const bannerReserve = activeAds("homepage-banner").find((ad) => ad.width && ad.height);

// The homepage is the most visited page, so it is served from Cloudflare's
// cache for up to a day: a cached copy is the fastest first load there is.
//
// It stays current because every CMS write that changes it -- a publish, a
// pin, the breaking banner, the carousel, developing stories -- purges the
// "homepage" cache tag (triangle-cms internal/cdnpurge; a URL purge of "/" does
// not evict HTML on this zone). What changes with no write is an island (see
// the imports), and the header's date and weather load after the page too.
// Anything new here that changes on its own must be an island as well, or it
// will be up to a day stale.
//
// Browsers keep it a minute: a purge cannot reach a reader's own cache.
// Cloudflare strips Cache-Tag before the response leaves the edge.
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=60, s-maxage=86400, stale-while-revalidate=300",
);
Astro.response.headers.set("Cache-Tag", "homepage");
---

<BaseLayout title="The Triangle">
    <HeroBackgroundPreload slot="head" slides={posts.carousel ?? []}/>
    <Header home deferWeather/>
    {breaking && <BreakingNewsBanner items={breakingItems}/> }
    <!-- {!breaking && <a id="one-hundred" href="https://therectangle.org" class="flex px-[16px] justify-end items-end w-full mt-[-24px] mb-[24px] h-[200px] md:h-[300px] bg-center text-white text-wrap font-bold uppercase font-libre text-[32px] sm:text-[48px] lg:text-[48px] leading-[normal] relative">
        <span class="z-[10] text-right">100 Years of The Triangle</span>
    </a>} -->
     <!-- Only the first block after the nav may pull up 24px to close its
          margin; when the breaking banner renders it takes that role. -->
     <Banner pullUp={!breaking} slides={posts.carousel ?? []}/>
     <HomeBannerAdIsland server:defer class={bannerClass}>
       {/* Holds the banner's space until the island lands, so the news lead
           below does not jump (layout shift on the most visited page). */}
       {bannerReserve && <div slot="fallback" class={bannerClass} aria-hidden="true"><div style={`aspect-ratio: ${bannerReserve.width} / ${bannerReserve.height}`}></div></div>}
     </HomeBannerAdIsland>

    <!-- The news lead is above the fold and the measured LCP element: PageSpeed's
         desktop run on 2026-10-13 picked this lead image (575x432) even with the
         anniversary background loaded, and flagged it for loading lazily. -->
    <Section section="news" articles={posts.news?.slice(0, 9)} style="3-6-3" priority/>
    <Section section="news" articles={posts.news?.slice(9)} style="row"/>
    <div class="grid grid-cols-[1fr] sm:grid-cols-[8fr_4fr] mt-2 xl:max-w-[1200px] lg:max-w-[900px] max-w-[90%] mx-[auto] mb-[8px] divide-x divide-triangleBlue border-t-[1px] border-solid border-triangleBlue pt-[5px] ">
        <div id="main-left" class="main-side">
            <Section section="opinion" articles={posts.opinion} includeName style="6-6" column="main"/>
            <Section section="sports" articles={posts.sports?.slice(0, 3)} includeName style="3-5" column="main"/>
            <Section section="sports" articles={posts.sports?.slice(3, 6)} style="row" column="main"/>
            <Section section="entertainment" articles={posts.entertainment} includeName style="6-6" column="main"/>
            <Section section="comics" slug="comics-puzzles" articles={posts.candp?.slice(0, 3)} includeName style="5-3" column="main"/>
            <Section section="comics" slug="comics-puzzles" articles={posts.candp?.slice(3, 6)} style="row" column="main"/>
        </div>
        <div id="main-right" class="hidden sm:block [&>*:not(:first-child)]:border-t-[1px] [&>*:not(:first-child)]:border-solid [&>*:not(:first-child)]:border-triangleBlue main-side">
            <!-- <a href="https://go.gwu.edu/AIinDC"><img class="ad medium-rectangle" src="/images/ads/gwu_ad_032626_to_042226.png"/></a> -->
            <ExhibitSpotlightIsland server:defer />
            <SidebarAdIsland server:defer />
            <SubscribeLink/>
            {posts.developingstories?.length > 0 && <Developing stories={posts.developingstories}/>}
            <!-- <MostRead/> -->
            <Column articles={posts.columns}/>
            <PollIsland server:defer />
            <Social />
        </div>
    </div>
</BaseLayout>
