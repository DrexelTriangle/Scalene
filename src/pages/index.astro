---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import Section from '../components/Sections/Section.astro';
import Header from '../components/Header.astro';
import Column from '../components/Columns.astro';
import Social from '../components/Social.astro';
import Poll from '../components/Polls.astro';
import BreakingNewsBanner from '../components/BreakingNewsBanner.astro'
import Developing from '../components/Developing.astro'
import '../styles/global.css';
import { getHomepageArticles } from '../utils/db';
import SubscribeLink from "../components/SubscribeLink.astro";
import Banner from "../components/Banner.astro";

const posts = await getHomepageArticles();

// `items` carries every story on the banner. A CMS that predates it sends only
// `text`/`article_slug`, so fall back to that pair rather than showing nothing:
// the two repos deploy independently, and an empty banner during the gap is
// exactly the failure worth avoiding.
const breakingNews = posts.breaking_news;
const breakingItems = (breakingNews?.items ?? [])
  .map((item) => ({ text: item.text?.trim() ?? "", article_slug: item.article_slug?.trim() }))
  .filter((item) => item.text !== "");
if (breakingItems.length === 0 && (breakingNews?.text?.trim() ?? "") !== "") {
  breakingItems.push({
    text: breakingNews!.text.trim(),
    article_slug: breakingNews?.article_slug?.trim(),
  });
}
const breaking = (breakingNews?.enabled ?? false) && breakingItems.length > 0;

// Far shorter than an article page's hour (see ArticleLayout): an article is
// finished once it publishes, but the homepage is the editors' live control
// surface -- the featured lead, the breaking banner and the carousel all change
// on demand and are worth nothing if the edge is holding yesterday's copy.
// Without this the page states no freshness at all and every cache in front of
// us invents its own.
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=60, s-maxage=60, stale-while-revalidate=300",
);
---

<BaseLayout title="The Triangle">
    <Header home/>
    {breaking && <BreakingNewsBanner items={breakingItems}/> }
    <!-- {!breaking && <a id="one-hundred" href="https://therectangle.org" class="flex px-[16px] justify-end items-end w-full mt-[-24px] mb-[24px] h-[200px] md:h-[300px] bg-center text-white text-wrap font-bold uppercase font-libre text-[32px] sm:text-[48px] lg:text-[48px] leading-[normal] relative">
        <span class="z-[10] text-right">100 Years of The Triangle</span>
    </a>} -->
    <!-- {!breaking && <Banner server:defer/>} -->
     <!-- Only the first block after the nav may pull up 24px to close its
          margin; when the breaking banner renders it takes that role. -->
     <Banner server:defer pullUp={!breaking} slides={posts.carousel ?? []}/>

    <Section section="news" articles={posts.news?.slice(0, 9)} style="3-6-3"/>
    <Section section="news" articles={posts.news?.slice(9)} style="row"/>
    <div class="grid grid-cols-[1fr] sm:grid-cols-[8fr_4fr] mt-2 xl:max-w-[1200px] lg:max-w-[900px] max-w-[90%] mx-[auto] mb-[8px] divide-x divide-triangleBlue border-t-[1px] border-solid border-triangleBlue pt-[5px] ">
        <div id="main-left" class="main-side">
            <Section section="opinion" articles={posts.opinion} includeName style="6-6"/>
            <Section section="sports" articles={posts.sports?.slice(0, 3)} includeName style="3-5"/>
            <Section section="sports" articles={posts.sports?.slice(3, 6)} style="row"/>
            <Section section="entertainment" articles={posts.entertainment} includeName style="6-6"/>
            <Section section="comics" slug="comics-puzzles" articles={posts.candp?.slice(0, 3)} includeName style="5-3"/>
            <Section section="comics" slug="comics-puzzles" articles={posts.candp?.slice(3, 6)} style="row"/>
        </div>
        <div id="main-right" class="hidden sm:block [&>*:not(:first-child)]:border-t-[1px] [&>*:not(:first-child)]:border-solid [&>*:not(:first-child)]:border-triangleBlue main-side">
            <!-- <a href="https://go.gwu.edu/AIinDC"><img class="ad medium-rectangle" src="/images/ads/gwu_ad_032626_to_042226.png"/></a> -->
            <SubscribeLink/>
            {posts.developingstories?.length > 0 && <Developing stories={posts.developingstories}/>}
            <!-- <MostRead/> -->
            <Column articles={posts.columns}/>
            <Poll />
            <Social />
        </div>
    </div>
</BaseLayout>
